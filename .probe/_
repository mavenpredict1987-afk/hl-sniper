<script>
/* v15.11: сканер кандидатов на вход по уровням S/R.
   Читает STATE.coin_scan, сортирует по «близости к сетапу», тап по строке — разбор монеты. */
function _lvlScore(s) {
  let sc = 0;
  if (s.chart_spring) sc += 100;
  if (s.chart_retest_long) sc += 60;
  const d = s.dist_sup_atr;
  if (d != null && isFinite(d) && d >= 0 && d < 3) sc += 30 * (1 - d / 3);
  sc += Math.min(s.sup_strength || 0, 6) * 5;
  const rr = s.chart_rr_long;
  if (rr != null && rr >= 2) sc += 20;
  return sc;
}
function renderLevels() {
  const body = $('lvl-body'), empty = $('lvl-empty'), hint = $('lvl-hint');
  if (!body || typeof STATE === 'undefined' || !STATE) return;
  const cs = STATE.coin_scan || {};
  const rows = Object.keys(cs)
    .filter(sym => { const s = cs[sym]; return s && (s.sup_levels || s.res_levels || s.dist_sup_atr != null); })
    .map(sym => [sym, cs[sym], _lvlScore(cs[sym])])
    .sort((a, b) => b[2] - a[2])
    .slice(0, 25);
  if (!rows.length) {
    body.innerHTML = '';
    empty.style.display = '';
    hint.textContent = '…';
    return;
  }
  empty.style.display = 'none';
  const nSetup = rows.filter(r => r[1].chart_spring || r[1].chart_retest_long).length;
  hint.textContent = rows.length + ' монет · сетапов: ' + nSetup;
  body.innerHTML = rows.map(function(r) {
    const sym = r[0], s = r[1];
    const d = s.dist_sup_atr, rr = s.chart_rr_long;
    let setup = '<span style="color:var(--dim)">—</span>';
    if (s.chart_spring) setup = '<b style="color:var(--teal)">🔥 СПРИНГ</b>';
    else if (s.chart_retest_long) setup = '<b style="color:var(--teal)">🔄 ретест ' + fmtPx(s.chart_retest_long) + '</b>';
    else if (d != null && d < 1) setup = '<span style="color:var(--amber)">у поддержки</span>';
    return '<tr onclick="openSheet(\'' + sym + '\')">' +
      '<td><b>' + sym + '</b></td>' +
      '<td>' + (s.price ? fmtPx(s.price) : '—') + '</td>' +
      '<td class="' + (d != null && d < 1 ? 'pos' : '') + '">' + (d != null ? d.toFixed(2) : '—') + '</td>' +
      '<td>' + (s.sup_strength != null ? s.sup_strength.toFixed(1) : '—') + '</td>' +
      '<td>' + (s.res_strength != null ? s.res_strength.toFixed(1) : '—') + '</td>' +
      '<td class="' + (rr != null && rr >= 2 ? 'pos' : 'neu') + '">' + (rr != null ? rr.toFixed(2) : '—') + '</td>' +
      '<td>' + setup + '</td>' +
    '</tr>';
  }).join('');
}
/* обновляем сканер вместе с основным циклом рендера */
(function(){
  if (typeof renderAll === 'function') {
    const orig = renderAll;
    renderAll = function(){ orig(); try { renderLevels(); } catch(e){} };
  }
  setInterval(function(){ try { renderLevels(); } catch(e){} }, 15000);
  renderLevels();
})();
</script>

