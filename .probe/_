<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>Hyperliquid Bot v15.1 — Дашборд</title>
<!-- v15.1: радар рынка удалён, стабильная версия -->
<link rel="manifest" href="/manifest.webmanifest">
<meta name="theme-color" content="#0c0e13">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="HL Bot">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<style>
  :root {
    --bg:#0c0e13; --card:#151822; --card2:#1a1e2a; --line:#232837;
    --txt:#ecebe6; --dim:#7d8494; --green:#4ade80; --red:#f87171;
    --amber:#fbbf24; --blue:#60a5fa; --violet:#a78bfa; --teal:#5cf2c9;
  }
  * { margin:0; padding:0; box-sizing:border-box; }
  html { -webkit-text-size-adjust:100%; scroll-behavior:smooth; }
  body { background:var(--bg); color:var(--txt); font-family:'Segoe UI',system-ui,-apple-system,sans-serif; padding:12px 12px 88px; max-width:1200px; margin:0 auto; }

  /* Шапка */
  .brand { font-family:'Arial Black','Segoe UI',Impact,sans-serif; font-size:30px; font-weight:900; letter-spacing:.14em; color:#97fce4; text-shadow:0 0 18px rgba(151,252,228,.45), 0 0 42px rgba(151,252,228,.18); line-height:1; }
  .brand-bot { color:#0c0e13; background:#97fce4; border-radius:8px; padding:2px 10px 3px; margin-left:10px; font-size:22px; vertical-align:4px; text-shadow:none; letter-spacing:.08em; }
  .brand-sub { font-size:10px; color:var(--dim); letter-spacing:.3em; text-transform:uppercase; margin-top:5px; }
  h1 { font-size:16px; font-weight:700; letter-spacing:.01em; }
  .dot { width:9px; height:9px; border-radius:50%; background:var(--dim); flex:none; }
  .dot.on { background:var(--green); box-shadow:0 0 8px var(--green); }
  .dot.halt { background:var(--red); box-shadow:0 0 8px var(--red); }
  .badge { font-size:10px; font-weight:800; letter-spacing:.06em; padding:3px 9px; border-radius:20px; border:1px solid; }
  .badge.paper { color:var(--blue); border-color:var(--blue); background:rgba(96,165,250,.08); }
  .badge.live { color:var(--red); border-color:var(--red); background:rgba(248,113,113,.08); }
  .badge.halted { color:var(--red); border-color:var(--red); }
  .badge.paused { color:var(--amber); border-color:var(--amber); }
  .upd { color:var(--dim); font-size:11px; }
  .hdr-btns { display:grid; grid-template-columns:repeat(4,1fr); gap:7px; margin-bottom:10px; }
  .hdr-btns .btn { width:100%; padding:10px 6px; font-size:12.5px; }
  .btn { display:inline-flex; align-items:center; justify-content:center; gap:6px; background:var(--card2); color:var(--txt); border:1px solid var(--line); border-radius:10px; padding:9px 13px; min-height:42px; font-size:13px; font-weight:600; text-decoration:none; cursor:pointer; -webkit-tap-highlight-color:transparent; touch-action:manipulation; user-select:none; transition:transform .12s ease, border-color .2s ease, background .2s ease; }
  .btn:hover { border-color:var(--blue); }
  .btn:active { transform:scale(.95); }
  .btn.warn { color:var(--amber); border-color:rgba(251,191,36,.4); }
  .btn.danger { color:var(--red); border-color:rgba(248,113,113,.4); }
  .btn.go { color:var(--green); border-color:rgba(74,222,128,.4); }
  .btn.small { min-height:34px; padding:6px 10px; font-size:12px; border-radius:8px; }

  /* Лента новостей */
  .ticker { background:var(--card); border:1px solid var(--line); border-radius:12px; overflow:hidden; margin-bottom:10px; position:relative; height:56px; display:flex; align-items:center; }
  .ticker-track { display:flex; white-space:nowrap; animation:tick 520s linear infinite; will-change:transform; }
  .ticker:hover .ticker-track, .ticker:active .ticker-track { animation-play-state:paused; }
  @keyframes tick { from { transform:translateX(0);} to { transform:translateX(-50%);} }
  .t-item { display:inline-flex; align-items:center; gap:8px; padding:0 22px 0 10px; margin:0 4px; font-size:14px; font-weight:700; color:var(--txt); text-decoration:none; border-left:3px solid rgba(125,132,148,.35); border-radius:6px; }
  .t-item.cat-listing { border-left-color:#4ade80; background:rgba(74,222,128,.08); }
  .t-item.cat-ai { border-left-color:#60a5fa; background:rgba(96,165,250,.09); }
  .t-item.cat-person { border-left-color:#fbbf24; background:rgba(251,191,36,.08); }
  .t-item.cat-reg { border-left-color:#f87171; background:rgba(248,113,113,.08); }
  .t-item.cat-market { border-left-color:rgba(125,132,148,.35); }
  .t-cat { font-size:9px; font-weight:900; letter-spacing:.06em; border-radius:5px; padding:2px 6px; }
  .t-cat.cat-listing { color:#4ade80; background:rgba(74,222,128,.14); border:1px solid rgba(74,222,128,.4); }
  .t-cat.cat-ai { color:#60a5fa; background:rgba(96,165,250,.14); border:1px solid rgba(96,165,250,.4); }
  .t-cat.cat-person { color:#fbbf24; background:rgba(251,191,36,.13); border:1px solid rgba(251,191,36,.4); }
  .t-cat.cat-reg { color:#f87171; background:rgba(248,113,113,.13); border:1px solid rgba(248,113,113,.4); }
  .t-cat.cat-market { color:#9aa1b2; background:rgba(125,132,148,.12); border:1px solid rgba(125,132,148,.3); }
  .t-src { font-size:10.5px; color:var(--dim); }
  .t-coin { font-size:9.5px; font-weight:800; color:var(--amber); background:rgba(251,191,36,.1); border:1px solid rgba(251,191,36,.3); border-radius:5px; padding:1px 6px; }
  .t-empty { color:var(--dim); font-size:12.5px; padding:0 14px; }

  /* Полоса статусов */
  .status-strip { display:grid; grid-template-columns:repeat(auto-fit,minmax(140px,1fr)); gap:7px; margin-bottom:10px; }
  .ind { background:var(--card); border:1px solid var(--line); border-radius:11px; padding:8px 11px; display:flex; align-items:center; gap:8px; }
  .ind .lamp { width:10px; height:10px; border-radius:50%; flex:none; }
  .ind .lamp.g { background:var(--green); box-shadow:0 0 7px var(--green); }
  .ind .lamp.y { background:var(--amber); box-shadow:0 0 7px var(--amber); }
  .ind .lamp.r { background:var(--red); box-shadow:0 0 7px var(--red); }
  .ind .lamp.b { background:var(--blue); box-shadow:0 0 7px var(--blue); }
  .ind .tt { font-size:9px; color:var(--dim); text-transform:uppercase; letter-spacing:.06em; }
  .ind .vv { font-size:12px; font-weight:700; margin-top:1px; }

  /* Карточка капитала — нажимается */
  .card { background:var(--card); border:1px solid var(--line); border-radius:14px; padding:14px 16px; }
  .equity-card { margin-bottom:10px; cursor:pointer; transition:border-color .25s ease; }
  .equity-card:active { border-color:var(--teal); }
  .equity-top { display:flex; align-items:baseline; gap:12px; flex-wrap:wrap; }
  .equity-label { color:var(--dim); font-size:10px; text-transform:uppercase; letter-spacing:.08em; }
  .equity-value { font-size:36px; font-weight:750; font-variant-numeric:tabular-nums; }
  .equity-delta { font-size:13px; font-weight:600; }
  .pos { color:var(--green); } .neg { color:var(--red); } .neu { color:var(--dim); }
  #spark { width:100%; height:90px; margin-top:8px; display:block; }
  .spark-empty { color:var(--dim); font-size:12px; padding:24px 0; text-align:center; }
  .eq-more { text-align:center; color:var(--dim); font-size:10.5px; margin-top:6px; letter-spacing:.04em; }

  /* Статы (раскрываются) */
  .stats { display:grid; grid-template-columns:repeat(auto-fit,minmax(140px,1fr)); gap:8px; }
  .stat .label { color:var(--dim); font-size:10px; text-transform:uppercase; letter-spacing:.06em; }
  .stat .value { font-size:18px; font-weight:650; margin-top:3px; font-variant-numeric:tabular-nums; }
  .stat .hint { color:var(--dim); font-size:10.5px; margin-top:2px; }

  /* Аккордеон-секции */
  .acc { margin-bottom:10px; }
  .acc-head { width:100%; display:flex; align-items:center; gap:10px; background:var(--card); border:1px solid var(--line); border-radius:13px; padding:12px 14px; cursor:pointer; -webkit-tap-highlight-color:transparent; touch-action:manipulation; user-select:none; transition:border-color .25s ease; font-family:inherit; color:var(--txt); text-align:left; }
  .acc-head:active { border-color:var(--teal); }
  .acc-ico { font-size:15px; flex:none; width:22px; text-align:center; display:flex; align-items:center; justify-content:center; }
  .acc-title { font-size:13px; font-weight:700; }
  .acc-sub { font-size:11px; color:var(--dim); margin-left:auto; text-align:right; flex:none; max-width:45%; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .acc-chev { color:var(--dim); font-size:12px; flex:none; transition:transform .3s ease; }
  .acc.open .acc-chev { transform:rotate(90deg); }
  .acc-body { display:grid; grid-template-rows:0fr; transition:grid-template-rows .38s cubic-bezier(.4,0,.2,1); }
  .acc.open .acc-body, .acc-body.open { grid-template-rows:1fr; }
  .acc-inner { overflow:hidden; min-height:0; }
  .acc-pad { padding:10px 2px 2px; }

  /* Полоса иконок монет */
  .coin-strip { display:flex; gap:8px; overflow-x:auto; padding:2px 2px 8px; scrollbar-width:none; scroll-snap-type:x proximity; }
  .coin-strip::-webkit-scrollbar { display:none; }
  .cs-item { flex:none; scroll-snap-align:start; display:flex; flex-direction:column; align-items:center; gap:4px; background:var(--card); border:1px solid var(--line); border-radius:12px; padding:9px 8px 7px; min-width:62px; cursor:pointer; transition:transform .18s ease, border-color .2s ease; -webkit-tap-highlight-color:transparent; }
  .cs-item:active { transform:scale(.92); }
  .cs-item.active { border-color:var(--teal); box-shadow:0 0 0 1px var(--teal) inset; }
  .cs-item.inpos { border-color:rgba(74,222,128,.5); }
  .cs-name { font-size:10px; font-weight:700; min-height:12px; }
  .cs-score { font-size:9px; color:var(--dim); font-variant-numeric:tabular-nums; min-height:11px; }

  /* Главный список монет — по 4 в ряд */
  #coin-strip { display:grid; grid-template-columns:repeat(4,1fr); gap:8px; overflow:visible; grid-auto-rows:1fr; }
  #coin-strip .cs-item { min-width:0; height:100%; min-height:88px; justify-content:flex-start; }
  #coin-strip .cs-name { min-height:12px; line-height:12px; text-align:center; word-break:break-all; }
  #coin-strip .cs-score { min-height:11px; line-height:11px; }

  /* Логотипы монет */
  .clogo { width:30px; height:30px; border-radius:50%; background:var(--card2); display:flex; align-items:center; justify-content:center; overflow:hidden; flex:none; font-weight:800; font-size:11px; color:var(--teal); }
  .clogo img { width:100%; height:100%; object-fit:cover; }
  .clogo.lg { width:40px; height:40px; font-size:14px; }
  .clogo.sm { width:22px; height:22px; font-size:9px; }

  /* Сетка всех монет — игра размеров */
  .coins-grid { display:flex; flex-wrap:wrap; gap:10px; align-items:flex-end; padding:6px 2px; }
  .cg-item { display:flex; flex-direction:column; align-items:center; gap:5px; background:var(--card2); border:1px solid var(--line); border-radius:14px; cursor:pointer; transition:transform .18s ease, border-color .2s ease; -webkit-tap-highlight-color:transparent; }
  .cg-item:active { transform:scale(.93); }
  .cg-item.s1 { padding:8px 10px; } .cg-item.s1 .clogo { width:26px; height:26px; font-size:10px; }
  .cg-item.s2 { padding:12px 14px; } .cg-item.s2 .clogo { width:36px; height:36px; font-size:12px; }
  .cg-item.s3 { padding:16px 18px; border-color:rgba(92,242,201,.35); } .cg-item.s3 .clogo { width:48px; height:48px; font-size:16px; }
  .cg-name { font-size:10px; font-weight:700; }
  .cg-reg { font-size:8.5px; color:var(--dim); }

  /* Позиции */
  .pos-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:10px; }
  .pos-card { background:var(--card); border:1px solid var(--line); border-radius:14px; padding:13px 15px; border-left:3px solid var(--dim); }
  .pos-card.long { border-left-color:var(--green); }
  .pos-card.short { border-left-color:var(--red); }
  .pos-head { display:flex; align-items:center; gap:9px; }
  .pos-sym { font-weight:800; font-size:15px; }
  .dir { font-size:9.5px; font-weight:800; padding:2px 8px; border-radius:6px; letter-spacing:.05em; }
  .dir.long { background:rgba(74,222,128,.12); color:var(--green); }
  .dir.short { background:rgba(248,113,113,.12); color:var(--red); }
  .pos-pnl { margin-left:auto; font-weight:750; font-size:14px; font-variant-numeric:tabular-nums; }
  .pos-pnl-usd { font-size:20px; font-weight:750; margin:4px 0 6px; font-variant-numeric:tabular-nums; }
  .bar { position:relative; height:6px; background:var(--card2); border-radius:3px; margin:8px 0 10px; }
  .bar .fill { position:absolute; top:0; height:100%; border-radius:3px; background:linear-gradient(90deg,var(--teal),var(--blue)); transition:width .5s ease; }
  .bar .tick { position:absolute; top:-3px; width:2px; height:12px; background:var(--amber); }
  .pos-rows { display:grid; grid-template-columns:1fr 1fr 1fr; gap:5px 10px; font-size:11.5px; }
  .pos-rows .k { color:var(--dim); display:block; font-size:9.5px; }
  .pos-rows .v { font-variant-numeric:tabular-nums; font-weight:600; }
  .pos-foot { display:flex; gap:6px; flex-wrap:wrap; margin-top:10px; align-items:center; }
  .chip { font-size:9.5px; color:var(--dim); background:var(--card2); border:1px solid var(--line); border-radius:20px; padding:3px 9px; }
  .chip.be { color:var(--amber); border-color:rgba(251,191,36,.35); }
  .coin-break { margin-left:auto; }

  /* Очередь */
  .queue-row { display:flex; align-items:center; gap:9px; padding:9px 4px; }
  .queue-row + .queue-row { border-top:1px solid rgba(35,40,55,.5); }
  .q-rank { width:24px; height:24px; border-radius:7px; background:var(--card2); border:1px solid var(--line); display:flex; align-items:center; justify-content:center; font-weight:800; font-size:11px; color:var(--dim); flex:none; }
  .q-rank.first { color:var(--amber); border-color:rgba(251,191,36,.5); }
  .q-bar { flex:1; height:9px; background:var(--card2); border-radius:5px; overflow:hidden; }
  .q-bar i { display:block; height:100%; border-radius:5px; transition:width .5s ease; }
  .q-scale { flex:1; display:flex; gap:2.5px; align-items:center; }
  .q-seg { flex:1; height:9px; border-radius:2.5px; background:var(--card2); transition:background .3s ease; }
  .q-pct { width:40px; text-align:right; font-weight:700; font-size:12px; font-variant-numeric:tabular-nums; }
  .q-note { font-size:10.5px; color:var(--dim); padding:0 4px 8px 37px; margin-top:-4px; }

  /* Журнал */
  .journal-row { display:flex; gap:9px; padding:6px 2px; border-bottom:1px solid rgba(35,40,55,.4); font-size:11.5px; align-items:baseline; }
  .journal-row:last-child { border-bottom:none; }
  .j-time { color:var(--dim); font-size:10.5px; flex:none; font-variant-numeric:tabular-nums; }
  .j-sym { font-weight:700; flex:none; width:56px; }

  /* Таблицы */
  table.list { width:100%; border-collapse:collapse; font-size:12px; }
  table.list th { text-align:left; color:var(--dim); font-size:9.5px; text-transform:uppercase; letter-spacing:.05em; padding:5px 6px; border-bottom:1px solid var(--line); white-space:nowrap; }
  table.list td { padding:7px 6px; border-bottom:1px solid rgba(35,40,55,.5); font-variant-numeric:tabular-nums; white-space:nowrap; }
  table.list tr:last-child td { border-bottom:none; }
  .tbl-wrap { overflow-x:auto; -webkit-overflow-scrolling:touch; }
  table.list tbody tr { cursor:pointer; transition:background .15s ease; }
  table.list tbody tr:active { background:var(--card2); }
  tr.sel td { background:rgba(92,242,201,.05); }
  .regime-tag { font-size:9.5px; font-weight:700; padding:2px 8px; border-radius:10px; }
  .regime-tag.trend { background:rgba(74,222,128,.1); color:var(--green); }
  .regime-tag.range { background:rgba(251,191,36,.1); color:var(--amber); }
  .regime-tag.chop { background:rgba(248,113,113,.1); color:var(--red); }
  .score-dual .r { display:flex; align-items:center; gap:4px; }
  .score-dual span { font-size:9px; color:var(--dim); width:8px; }
  .score-dual .b { width:52px; height:4px; background:var(--card2); border-radius:2px; overflow:hidden; }
  .score-dual .b i { display:block; height:100%; }
  .inp { display:inline-block; font-size:8px; color:var(--green); border:1px solid rgba(74,222,128,.4); border-radius:4px; padding:0 4px; margin-left:5px; vertical-align:1px; }
  td.hot { color:var(--amber); font-weight:700; }

  /* Критерии */
  .crit-head { display:flex; justify-content:space-between; align-items:center; margin-bottom:10px; flex-wrap:wrap; gap:6px; }
  .crit-sym { font-size:15px; font-weight:800; display:flex; align-items:center; gap:8px; }
  .crit-req { font-size:10.5px; color:var(--dim); }
  .score-row { display:flex; align-items:center; gap:10px; margin:8px 0; }
  .score-row .n { width:42px; font-size:11.5px; color:var(--dim); }
  .score-bar { flex:1; height:14px; background:var(--card2); border-radius:7px; position:relative; overflow:hidden; }
  .score-bar .f { height:100%; border-radius:7px; transition:width .6s ease; }
  .score-bar .th, .score-bar .th2 { position:absolute; top:-2px; width:2px; height:18px; background:var(--amber); }
  .score-bar .th2 { background:var(--violet); }
  .score-val { width:38px; text-align:right; font-weight:700; font-size:12.5px; }
  .comp-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(120px,1fr)); gap:8px; margin-top:10px; }
  .comp { background:var(--card2); border-radius:10px; padding:9px 11px; }
  .comp .t { font-size:9.5px; color:var(--dim); }
  .comp .c { font-size:14px; font-weight:700; margin-top:2px; }
  .bar-mini { height:4px; background:rgba(0,0,0,.3); border-radius:2px; margin-top:6px; overflow:hidden; }
  .bar-mini i { display:block; height:100%; }
  .crit-status { margin-top:12px; padding:9px 12px; border-radius:10px; font-size:12px; font-weight:650; text-align:center; }
  .crit-status.wait { background:var(--card2); color:var(--dim); }
  .crit-status.close { background:rgba(251,191,36,.1); color:var(--amber); }
  .crit-status.fire { background:rgba(74,222,128,.12); color:var(--green); }

  /* Аналитика */
  .an-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(100px,1fr)); gap:7px; margin-bottom:10px; }
  .an { background:var(--card2); border:1px solid var(--line); border-radius:10px; padding:8px 10px; }
  .an .t { font-size:9px; color:var(--dim); text-transform:uppercase; letter-spacing:.05em; }
  .an .v { font-size:15px; font-weight:700; margin-top:2px; font-variant-numeric:tabular-nums; }
  .an-table { width:100%; border-collapse:collapse; font-size:11px; }
  .an-table td { padding:5px 6px; border-bottom:1px solid rgba(35,40,55,.4); font-variant-numeric:tabular-nums; }
  .an-table td:last-child { text-align:right; }
  .an-cap { font-size:9.5px; color:var(--dim); text-transform:uppercase; letter-spacing:.06em; margin:10px 0 4px; }

  .empty { color:var(--dim); font-size:12px; padding:12px 4px; text-align:center; }
  .section-note { color:var(--dim); font-size:10.5px; margin:2px 2px 8px; }

  /* Радио */
  .radio-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(105px,1fr)); gap:7px; }
  .r-st { background:var(--card2); border:1px solid var(--line); border-radius:10px; padding:10px 8px; font-size:11px; font-weight:650; text-align:center; cursor:pointer; transition:transform .15s ease, border-color .2s ease; -webkit-tap-highlight-color:transparent; font-family:inherit; color:var(--txt); min-height:44px; }
  .r-st:active { transform:scale(.94); }
  .r-st.on { border-color:var(--teal); color:var(--teal); box-shadow:0 0 0 1px var(--teal) inset; }
  .r-genre { display:block; font-size:8.5px; color:var(--dim); font-weight:400; margin-top:2px; }
  .music-links { display:flex; flex-wrap:wrap; gap:7px; margin-top:12px; }
  .music-links a { font-size:11px; color:var(--blue); background:var(--card2); border:1px solid var(--line); border-radius:20px; padding:7px 13px; text-decoration:none; min-height:36px; display:inline-flex; align-items:center; gap:5px; }
  .r-cap { font-size:9.5px; color:var(--dim); text-transform:uppercase; letter-spacing:.06em; margin:12px 0 6px; }

  /* Нижний лист (разбор по монете) */
  .sheet-bg { position:fixed; inset:0; background:rgba(0,0,0,.6); backdrop-filter:blur(3px); opacity:0; pointer-events:none; transition:opacity .3s ease; z-index:60; }
